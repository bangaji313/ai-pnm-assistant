{
  "name": "ai-pnm-assistant",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "check": "npm run typecheck && npm test && npm run build",
    "test:live": "vitest run src/lib/mistral.live.test.ts",
    "format": "prettier --write src docs *.json *.ts *.md",
    "format:check": "prettier --check src docs *.json *.ts *.md",
    "quota:cleanup": "node scripts/cleanup-quota.mjs"
  },
  "dependencies": {
    "firebase": "12.7.0",
    "firebase-admin": "14.5.0",
    "next": "16.4.3",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "prettier": "3.9.10",
    "typescript": "^5.9.3",
    "vitest": "4.1.12"
  },
  "engines": {
    "node": ">=22 <25"
  },
  "overrides": {
    "@grpc/grpc-js": "1.14.7"
  },
  "type": "module"
}
